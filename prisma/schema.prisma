// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth.js Models ────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  bookmarks     Bookmark[]
  watchHistory  WatchHistory[]
  comments      Comment[]
  commentLikes  CommentLike[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App Models ─────────────────────────────────────────

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  animeId   String   // AniList ID or AnimeKAI ID
  title     String
  poster    String?
  href      String   // Link like /anime/animekai~solo-leveling-9038n
  status    String   @default("WATCHING") // WATCHING, COMPLETED, PLAN_TO_WATCH, DROPPED, ON_HOLD
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([userId])
}

model WatchHistory {
  id            String   @id @default(cuid())
  userId        String
  animeId       String
  episodeNumber Int
  progress      Float    @default(0) // 0 to 1
  duration      Float    @default(0) // in seconds
  title         String   // Anime title
  poster        String?
  href          String
  provider      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, animeId, episodeNumber])
  @@index([userId])
  @@index([userId, animeId])
}

model AnimeProviderMapping {
  id            String   @id @default(cuid())
  anilistId     Int
  provider      String
  providerId    String?
  status        String   @default("UNKNOWN")
  matchedTitle  String?
  checkedTitles String[] @default([])
  failureReason String?
  lastCheckedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([anilistId, provider])
  @@index([provider, status])
  @@index([lastCheckedAt])
}

model AnimeProviderSnapshot {
  id           String   @id @default(cuid())
  provider     String
  providerId   String
  title        String
  synopsis     String?
  poster       String?
  banner       String?
  description  String?
  genres       String[] @default([])
  type         String?
  rating       String?
  year         String?
  status       String?
  subCount     Int?
  dubCount     Int?
  episodeCount Int?
  anilistId    Int?
  malId        Int?
  providerIds  Json?
  metadata     Json
  seasons      Json
  related      Json
  recommended  Json
  lastFetchedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([provider, lastFetchedAt])
}

model AnimeEpisodeSnapshot {
  id                String   @id @default(cuid())
  provider          String
  providerId        String
  episodeNumber     Int
  title             String
  image             String?
  isFiller          Boolean  @default(false)
  isSubbed          Boolean?
  isDubbed          Boolean?
  idByProvider      Json
  availableProviders String[] @default([])
  lastFetchedAt     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerId, episodeNumber])
  @@index([provider, providerId, lastFetchedAt])
}

model Comment {
  id            String   @id @default(cuid())
  userId        String
  animeId       String
  episodeNumber Int?     // null = general anime comment
  content       String
  isSpoiler     Boolean  @default(false)
  timestamp     Float?   // optional video timestamp in seconds (for linking)
  parentId      String?  // for replies (threaded comments)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[]     @relation("CommentReplies")
  likes    CommentLike[]

  @@index([animeId, episodeNumber])
  @@index([userId])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

// ─── Stream Caching & Background Seeding ────────────────────────────────────

/// Stores resolved HLS stream links for each anime episode.
/// Populated by the background catalog cron job (catalog_cron.py).
/// Queried first on every watch request for instant playback (DB-first).
model EpisodeStream {
  id             String   @id @default(cuid())
  anilistId      Int
  episodeNumber  Int
  dubbed         Boolean  @default(false)
  provider       String                     // "gogoanime", "animepahe", etc.
  miruroProvider String?                    // Miruro internal alias: "bonk", "kiwi"
  quality        String   @default("auto")  // best quality label: "1080p", "720p", "auto"
  streamUrl      String                     // Primary HLS m3u8 URL (best quality)
  referer        String?                    // Required Referer header for the CDN
  streams        Json     @default("[]")    // All quality variants: [{url, type, quality, referer}]
  subtitles      Json     @default("[]")    // Subtitle tracks: [{url, label, lang, isDefault}]
  intro          Json?                      // Skip intro times: {start, end} in seconds
  outro          Json?                      // Skip outro times: {start, end} in seconds
  episodeTitle   String?
  isStale        Boolean  @default(false)   // True when reported by user — cron will refresh
  lastFetchedAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([anilistId, episodeNumber, dubbed, provider])
  @@index([anilistId])
  @@index([anilistId, episodeNumber])
  @@index([isStale])
  @@index([lastFetchedAt])
}

/// Tracks the catalog cron job's progress across all anime.
/// Allows the cron to resume exactly where it left off on redeploy.
model SeedingState {
  id             String    @id @default(cuid())
  anilistId      Int       @unique
  status         String    @default("PENDING")  // PENDING | IN_PROGRESS | SEEDED | FAILED
  totalEpisodes  Int       @default(0)          // Known episode count from AniList
  seededEpisodes Int       @default(0)          // Successfully stored episodes
  failureCount   Int       @default(0)          // Consecutive scrape failures
  failureReason  String?                        // Last error message
  priority       Int       @default(0)          // Higher = processed sooner. Airing=100, Popular=50, Default=0
  nextAiringAt   DateTime?                      // When next episode airs (from AniList airing cron)
  nextAiringEp   Int?                           // Next airing episode number
  lastCheckedAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, priority])
  @@index([nextAiringAt])
  @@index([lastCheckedAt])
}

// ─── Watch Party (Watch2Together) ───────────────────────────────────────────

/// A shared watch room identified by a short code (e.g. "ANIM4X").
/// Anonymous — members are stored as JSON. Rooms expire after 6 h of inactivity.
model WatchPartyRoom {
  id            String   @id @default(cuid())
  code          String   @unique          // e.g. "ANIM4X" — user-facing room code
  hostId        String                    // anonymous UUID stored in client localStorage
  animeId       String                    // e.g. "anilist~12345"
  animeTitle    String
  animePoster   String?
  episodeNumber Int      @default(1)
  currentTime   Float    @default(0)      // current playback position in seconds
  isPlaying     Boolean  @default(false)
  members       Json     @default("[]")   // [{ id, name, joinedAt }]
  lastActivityAt DateTime @default(now())
  expiresAt     DateTime                  // room is deleted after this time
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events WatchPartyEvent[]

  @@index([code])
  @@index([expiresAt])
  @@index([lastActivityAt])
}

/// Ephemeral event queue for SSE delivery.
/// Events older than 60s are cleaned up by the stream endpoint.
model WatchPartyEvent {
  id        String   @id @default(cuid())
  roomCode  String
  memberId  String                        // who sent it
  memberName String
  type      String                        // "play"|"pause"|"seek"|"episode"|"chat"|"join"|"leave"
  payload   Json                          // event-specific data
  createdAt DateTime @default(now())

  room WatchPartyRoom @relation(fields: [roomCode], references: [code], onDelete: Cascade)

  @@index([roomCode, createdAt])
  @@index([createdAt])
}
