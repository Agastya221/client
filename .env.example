# Anime backend
# NOTE: lib/anime/api.ts falls back to http://localhost:5000 (not :4000) when
# this is unset, so an unset value in production silently points at localhost.
# Always set this explicitly in every deployed environment.
ANIME_API_BASE_URL=http://localhost:5000

# Anivexa API 2.2.1, deployed on Render (Upstash Redis enabled).
# Takes priority over NEXT_PUBLIC_ANIVEXA_WORKER_URL in lib/anime/api.ts.
ANIVEXA_API_BASE_URL=https://tatakai-anivexa-api.onrender.com

# Public fallback for the Anivexa API, readable from the browser bundle.
# lib/anime/api.ts throws "NEXT_PUBLIC_ANIVEXA_WORKER_URL is not configured"
# when neither this nor ANIVEXA_API_BASE_URL is set.
NEXT_PUBLIC_ANIVEXA_WORKER_URL=https://tatakai-anivexa-api.onrender.com

# Auth.js session secret. Also signs the DASH proxy tokens in
# lib/anime/dash-proxy.ts — DASH playback is disabled without it, and
# lib/auth.ts otherwise falls back to a hardcoded default that MUST NOT be
# used in production. Generate with: npx auth secret   (or: openssl rand -base64 32)
# NEXTAUTH_SECRET is accepted as a legacy alias.
AUTH_SECRET=GENERATE_A_RANDOM_32_BYTE_SECRET

# PostgreSQL / Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# Cloudflare Workers only: Hyperdrive pooled connection string.
# lib/db.ts prefers HYPERDRIVE_DATABASE_URL > POSTGRES_URL > DATABASE_URL.
# Leave unset everywhere except the deployed Worker. See DEPLOY-CLOUDFLARE.md.
# HYPERDRIVE_DATABASE_URL=postgresql://user:password@HYPERDRIVE_HOST/DBNAME
#
# Escape hatch: read the connection string from a differently-named variable
# without a code change.
# POSTGRES_CONNECTION_STRING_VAR=MY_PLATFORM_DB_URL

# Frontend public URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AniList OAuth Credentials
# Create API Client at: https://anilist.co/settings/developer
# Set Redirect URL to: https://<YOUR-DOMAIN>/api/auth/callback/anilist
ANILIST_CLIENT_ID=YOUR_ANILIST_CLIENT_ID
ANILIST_CLIENT_SECRET=YOUR_ANILIST_CLIENT_SECRET

# Optional transparent title-logo fallback
# Create a free project key at: https://fanart.tv/get-an-api-key/
FANART_TV_API_KEY=YOUR_FANART_TV_API_KEY

# API response cache: process memory (L1) + Cloudflare KV (persistent L2)
# KV is automatically disabled during local development and `next build`.
# Production runtime enables it when all three credentials below are present.
# Only set CF_KV_ALLOW_LOCAL=true for an intentional local integration test.
# On Cloudflare Workers these three REST credentials can eventually be dropped
# in favour of the native APP_CACHE_KV binding in wrangler.jsonc — see the
# "KV: REST to native binding" follow-up in DEPLOY-CLOUDFLARE.md. They are
# still required today.
CF_KV_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CF_KV_NAMESPACE_ID=YOUR_KV_NAMESPACE_ID
CF_KV_API_TOKEN=YOUR_KV_API_TOKEN
CF_KV_ENABLED=true
CF_KV_ALLOW_LOCAL=false
CF_KV_ALLOW_BUILD=false

# Discord Integration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID

# Watch Party is OFF by default (its live sync cannot run on Cloudflare Workers).
# Set to "true" only on a Node host (next dev / next start) to re-enable it.
# NEXT_PUBLIC_WATCH_PARTY_ENABLED=true
